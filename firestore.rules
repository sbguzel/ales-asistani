rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Soru Havuzu: Herkes okuyabilir, istemciden (webden) silme/değiştirme kesinlikle KAPALIDIR
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Sistem & Manifesto: Herkes okuyabilir, istemciden yazma KAPALIDIR
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Kullanıcı Profili ve İlerleme: Kullanıcı sadece kendi hesabına ait dokümanı yönetebilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Soru Çözüm Denemeleri (Attempts): Sadece oturum açmış kullanıcı kendi adına kayıt açabilir ve okuyabilir
    match /user_attempts/{attemptId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Varsayılan Güvenlik: Kural tanımlanmamış hiçbir koleksiyona erişilemez
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
